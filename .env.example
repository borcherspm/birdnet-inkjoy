# ==============================================================================
# Backyard Bird Detection & Dashboard Environment Configuration
# Copy this file to .env and adjust your settings:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Camera & Audio Stream
# ------------------------------------------------------------------------------
# Your camera's RTSP audio stream URL.
# Common formats:
#   Hikvision/HiLook:  rtsp://admin:password@192.168.1.50:554/Streaming/Channels/101
#   Reolink:           rtsp://admin:password@192.168.1.50:554/h264Preview_01_main
#   UniFi Protect:     rtsp://192.168.1.1:7447/<rtsp-token>
#   Generic / Tapo:    rtsp://username:password@192.168.1.50:554/stream1
CAMERA_RTSP_URL=rtsp://admin:password@192.168.1.50:554/Streaming/Channels/101

# Source slug used by BirdNET-Go for entity naming in Home Assistant:
# E.g., 'backyard', 'garden', 'frontyard'
SOURCE_SLUG=backyard

# ------------------------------------------------------------------------------
# 2. Location & Regional Range Filter
# ------------------------------------------------------------------------------
# Coordinates are crucial! BirdNET uses them to filter candidate bird species
# strictly according to what actually lives in your region and season.
LATITUDE=37.7749
LONGITUDE=-122.4194
TZ=America/Los_Angeles

# Language for bird common names (e.g. en, de, fr, es)
LOCALE=en

# User / Group permissions for Docker volume mounts
PUID=1000
PGID=1000

# ------------------------------------------------------------------------------
# 3. Port Bindings
# ------------------------------------------------------------------------------
BIRDNET_PORT=8080
TESSERAE_PORT=8765
SAEZURI_PORT=8090
MOSQUITTO_PORT=1883

# Hostname / domain if using a reverse proxy
BIRDNET_HOSTNAME=birdnet.local
TESSERAE_HOSTNAME=tesserae.local
SAEZURI_HOSTNAME=birds.local
HA_HOSTNAME=homeassistant.local

# ------------------------------------------------------------------------------
# 4. MQTT Broker (Home Assistant Integration)
# ------------------------------------------------------------------------------
# If you run the included Mosquitto container, leave as localhost or 'mosquitto'
# If Home Assistant runs its own Mosquitto broker, enter its IP/host here.
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=birdnet
MQTT_PASSWORD=secretbirdnetpass
MQTT_TOPIC=birdnet

# ------------------------------------------------------------------------------
# 5. InkJoy Muse Frame Integration
# ------------------------------------------------------------------------------
# If you own an InkJoy Muse frame, enter your InkJoy app credentials here:
INKJOY_EMAIL=
INKJOY_PASSWORD=
INKJOY_DEVICE_ID=
TESSERAE_URL=http://homeassistant.local:8765
# Optional: Bearer token from Tesserae (Settings -> System -> MCP) if not on loopback
TESSERAE_TOKEN=

# ------------------------------------------------------------------------------
# 6. Optional Integrations & AI Art Generation
# ------------------------------------------------------------------------------
# Tesserae Backyard Birds widget AI generation (optional fal.ai key for custom plates)
FAL_KEY=

# Saezuri illustration generation fallback (optional Google Gemini API key)
GEMINI_API_KEY=

# Token generated in BirdNET-Go UI (if basic auth / token is required by clients)
BIRDNETGO_TOKEN=
