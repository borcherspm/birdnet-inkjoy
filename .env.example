# ==============================================================================
# Backyard Bird Detection & InkJoy Frame Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. InkJoy Account Credentials (same as your InkJoy phone app)
# ------------------------------------------------------------------------------
INKJOY_EMAIL=your_email@example.com
INKJOY_PASSWORD=your_password
INKJOY_DEVICE_ID=04705c97-0151-45c0-b2d0-593f329bbdc5

# ------------------------------------------------------------------------------
# 2. Tesserae Connection & Authentication
# ------------------------------------------------------------------------------
# Address where Tesserae is running:
TESSERAE_URL=http://homeassistant.local:8765

# MCP / API Bearer Token from Tesserae (Settings -> System -> MCP):
TESSERAE_TOKEN=your_token_here

# ------------------------------------------------------------------------------
# 3. BirdNET-Go Live Stream Connection
# ------------------------------------------------------------------------------
# Internal Home Assistant address for the BirdNET-Go container:
BIRDNET_URL=http://db21ed7f-birdnet-go:8080

# ------------------------------------------------------------------------------
# 4. Artwork Layout & Style Preferences
# ------------------------------------------------------------------------------
# Available layouts: cluster, list, latest, plate, bleed, gallery, chart
BIRD_LAYOUT=cluster

# Sub-styles:
# If BIRD_LAYOUT=cluster: sheet (Specimen sheet), numbered, wreath, notebook, drawer
# If BIRD_LAYOUT=bleed: folio (Victorian plate), museum, cyanotype, stamp, woodblock
BIRD_STYLE=sheet
